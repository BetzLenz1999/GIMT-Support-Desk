TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback only if you intentionally use RLS-compatible anon access.
SUPABASE_ANON_KEY=
CRON_SECRET=
# Support flow switch: old keeps the current ticket flow, ai enables draft auto-response templates.
SUPPORT_MODE=old
# Team inbox: when on, non-user group support messages are DM'd to all registered
# team members so they can reply via the bot (with a clickable name signature).
TEAM_INBOX_MODE=off
